rules_version = '2';

// À déployer sur la console Firebase (Firestore Database > Règles) ou via
// `firebase deploy --only firestore:rules` (Firebase CLI).
//
// Principe : chaque appareil (document devices/{matricule}) n'est lisible et
// modifiable QUE par l'utilisateur anonyme (ownerUid) qui l'a créé, OU par
// un compte direction (collection staff/{uid}, voir README). Personne
// d'autre ne peut lire la position, les photos ou l'historique d'un élève.
//
// La direction utilise la console web direction-console.html (compte
// email/mot de passe) pour déclencher/arrêter l'alarme, verrouiller l'écran
// (champ lock) et consulter l'historique devices/{matricule}/track.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    // Fiche d'un membre de la direction : lisible uniquement par lui-même.
    // (Créée manuellement par l'admin via la console Firebase.)
    match /staff/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /devices/{matricule} {

      // Création : uniquement si le document n'existe pas encore et que
      // l'appareil s'enregistre comme son propre ownerUid.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    // Le matricule sert de clé : on refuse les champs sensibles
                    // (photo/position/token) à la création — valeurs sûres uniquement.
                    && request.resource.data.status == "securise"
                    && !("photoBase64" in request.resource.data)
                    && !("pinHash" in request.resource.data)
                    && !("pin_code" in request.resource.data);

      // Lecture : propriétaire OU direction.
      allow get: if (request.auth != null
                    && resource.data.ownerUid == request.auth.uid)
                    || isStaff();
      allow list: if isStaff();

      // Mise à jour propriétaire : tout sauf changer ownerUid ou écrire un PIN.
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && !("pinHash" in request.resource.data)
                    && !("pin_code" in request.resource.data);

      // Mise à jour direction : UNIQUEMENT status + lock (jamais position,
      // photo, token, ownerUid). Le test request.resource.data.diff(...).
      // affectedKeys().hasOnly([...]) garantit que seuls ces 2 champs bougent.
      allow update: if isStaff()
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["status", "lock"]);

      allow delete: if false;

      // Historique GPS : le propriétaire écrit, la direction lit.
      // (La suppression des vieux points par l'appli reste possible
      // car delete est autorisé au propriétaire uniquement sur track/.)
      match /track/{pointId} {
        allow create, delete: if request.auth != null
                    && get(/databases/$(database)/documents/devices/$(matricule)).data.ownerUid == request.auth.uid;
        allow read: if (request.auth != null
                    && get(/databases/$(database)/documents/devices/$(matricule)).data.ownerUid == request.auth.uid)
                    || isStaff();
        allow update: if false;
      }
    }
  }
}
