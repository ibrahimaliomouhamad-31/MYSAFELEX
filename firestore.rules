rules_version = '2';

// À déployer sur la console Firebase (Firestore Database > Règles) ou via
// `firebase deploy --only firestore:rules` (Firebase CLI).
//
// Principe : chaque appareil (document devices/{matricule}) n'est lisible et
// modifiable QUE par l'utilisateur anonyme (ownerUid) qui l'a créé. Personne
// d'autre ne peut lire la position, les photos ou l'audio d'un autre élève,
// ni déclencher/désactiver une alerte à distance depuis l'application.
//
// La direction, elle, continue de modifier le champ "status" directement
// depuis la console Firebase (qui utilise des accès administrateur et
// n'est donc pas soumise à ces règles) — aucun changement nécessaire de ce
// côté pour l'instant.
service cloud.firestore {
  match /databases/{database}/documents {
    match /devices/{matricule} {

      // Création : uniquement si le document n'existe pas encore et que
      // l'appareil s'enregistre comme son propre ownerUid.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    // Le matricule sert de clé : on refuse les champs sensibles
                    // (photo/position/token) à la création — valeurs sûres uniquement.
                    && request.resource.data.status == "securise"
                    && !("photoBase64" in request.resource.data)
                    && !("pinHash" in request.resource.data)
                    && !("pin_code" in request.resource.data);

      // Lecture / mise à jour : uniquement le propriétaire d'origine.
      // (resource.data fait référence au document AVANT l'écriture, donc
      // même si quelqu'un essaie d'écraser ownerUid, la vérification porte
      // toujours sur le vrai propriétaire existant.)
      allow read, update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    // On interdit de changer de propriétaire ou d'écrire un PIN.
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && !("pinHash" in request.resource.data)
                    && !("pin_code" in request.resource.data);

      allow delete: if false;
    }
  }
}
