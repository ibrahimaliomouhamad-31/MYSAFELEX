rules_version = '2';

// À déployer sur la console Firebase (Storage > Règles) ou via
// `firebase deploy --only storage`.
//
// Chaque appareil ne peut lire/écrire que son propre dossier
// devices/{matricule}/..., vérifié en croisant avec le document Firestore
// correspondant (ownerUid). Sans cela, les photos et enregistrements audio
// "secrets" seraient accessibles à quiconque devine ou connaît un matricule.
service firebase.storage {
  match /b/{bucket}/o {
    match /devices/{matricule}/{fileName} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/devices/$(matricule)).data.ownerUid == request.auth.uid;
    }
  }
}
