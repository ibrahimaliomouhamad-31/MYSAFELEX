<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_header_gradient"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo MYSAFELEX"
        android:background="@drawable/bg_pill"
        android:padding="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MYSAFELEX"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:letterSpacing="0.06"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lycee d Excellence de Tessaoua"
        android:textSize="14sp"
        android:textColor="#FFD9D9"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtSplashVersion"
        style="@style/Lex.Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.4"
        android:layout_marginTop="18dp" />
</LinearLayout>
